<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ProtoGen.Wasm.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The engine targets net10.0-browser and exports itself through [JSExport], neither of which a
       test host can load, so its sources are compiled in here instead of referenced. Program.cs is
       the only file that touches the JS boundary, and is the only one left out. Everything under
       test is `internal`, which this arrangement gives us for free. -->
  <ItemGroup>
    <Compile Include="..\ProtoGen.Wasm\*.cs"
             Exclude="..\ProtoGen.Wasm\Program.cs"
             Link="Engine\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net.Reflection" Version="3.3.21" />
    <!-- protobuf-net.Reflection brings only protobuf-net.Core, which has no concrete TypeModel;
         DescriptorSetDecodeTests needs one to serialize a FileDescriptorSet into a payload. -->
    <PackageReference Include="protobuf-net" Version="3.3.21" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
